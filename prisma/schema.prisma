// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(SELLER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  seller        Seller?
  vendor        Vendor?
  adminTeam     AdminTeamMember?
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  messages      Message[]
  comments      Comment[]

  @@map("users")
}

enum UserRole {
  ADMIN
  SELLER
  VENDOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// SELLER (Supplier) Management
// ============================================================

model Seller {
  id              String        @id @default(cuid())
  userId          String        @unique
  companyName     String
  industry        String?
  companySize     String?
  website         String?
  description     String?       @db.Text
  status          SellerStatus  @default(PENDING)
  tier            SellerTier    @default(BRONZE)
  dealsClosed     Int           @default(0)
  revenue         Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        Project[]
  teamMembers     TeamMember[]

  @@map("sellers")
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SellerTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
}

// ============================================================
// VENDOR Management
// ============================================================

model Vendor {
  id            String        @id @default(cuid())
  userId        String        @unique
  companyName   String
  industry      String?
  companySize   String?
  website       String?
  description   String?       @db.Text
  status        VendorStatus  @default(PENDING)
  tier          VendorTier    @default(BRONZE)
  activeProjects Int          @default(0)
  revenue       Float         @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes        Quote[]

  @@map("vendors")
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
}

// ============================================================
// PROJECT Management
// ============================================================

model Project {
  id              String         @id @default(cuid())
  projectId       String         @unique // PRJ-001 format
  name            String
  description     String         @db.Text
  requirements    String?        @db.Text
  category        String
  status          ProjectStatus  @default(SUBMITTED)
  priority        ProjectPriority @default(MEDIUM)
  
  // Budget
  budgetMin       Float?
  budgetMax       Float?
  budgetCurrency  String         @default("USD")
  budgetRange     String?
  
  // Timeline
  startDate       DateTime?
  endDate         DateTime?
  
  // Files
  files           ProjectFile[]
  
  // Relations
  sellerId        String
  seller          Seller         @relation(fields: [sellerId], references: [id])
  
  // Status History
  statusHistory   StatusHistory[]
  
  // Notes & Comments
  notes           Note[]
  comments        Comment[]
  
  // Quotes from vendors
  quotes          Quote[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("projects")
}

enum ProjectStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  NEED_CLARIFICATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  size        String
  type        String
  url         String?
  uploadedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model StatusHistory {
  id          String        @id @default(cuid())
  projectId   String
  status      ProjectStatus
  note        String?       @db.Text
  changedBy   String
  createdAt   DateTime      @default(now())

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  text      String   @db.Text
  type      NoteType
  createdAt DateTime @default(now())
  createdBy String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notes")
}

enum NoteType {
  CLARIFICATION
  STATUS_CHANGE
  GENERAL
}

// ============================================================
// QUOTES (Vendor responses to projects)
// ============================================================

model Quote {
  id          String      @id @default(cuid())
  projectId   String
  vendorId    String
  amount      Float
  currency    String      @default("USD")
  duration    Int?        // in days
  proposal    String?     @db.Text
  status      QuoteStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("quotes")
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ============================================================
// PRODUCTS (Factory/Summon Products)
// ============================================================

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  longDescription String? @db.Text
  category    String
  basePrice   Float
  currency    String   @default("USD")
  features    String[] // Stored as JSON string array
  useCases    String[] // Stored as JSON string array
  images      String[] // Stored as JSON string array
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// ============================================================
// MESSAGING System
// ============================================================

model Conversation {
  id          String    @id @default(cuid())
  participants String[]  // User IDs
  type        ConversationType @default(INDIVIDUAL)
  lastMessage String?   @db.Text
  lastAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    Message[]

  @@map("conversations")
}

enum ConversationType {
  INDIVIDUAL
  GROUP
  PROJECT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  attachments    String[]     // File URLs
  readBy         String[]     // User IDs who read
  createdAt      DateTime     @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@map("messages")
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String?          @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  PROJECT_SUBMITTED
  PROJECT_ACCEPTED
  PROJECT_REJECTED
  PROJECT_CLARIFICATION
  MESSAGE_RECEIVED
  QUOTE_RECEIVED
  SYSTEM
}

// ============================================================
// ADMIN TEAM
// ============================================================

model AdminTeamMember {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String
  role        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_team_members")
}

// ============================================================
// TEAM MEMBERS (Seller's internal team)
// ============================================================

model TeamMember {
  id        String   @id @default(cuid())
  sellerId  String
  name      String
  email     String
  role      String
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("team_members")
}

// ============================================================
// COMMENTS (Project discussions)
// ============================================================

model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ============================================================
// CATEGORIES (For projects and products)
// ============================================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  type      CategoryType
  createdAt DateTime @default(now())

  @@map("categories")
}

enum CategoryType {
  PROJECT
  PRODUCT
}
